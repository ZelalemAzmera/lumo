# Lumo Environment Configuration Example

# Core Server Configuration
LUMO_ENV=development
LUMO_API_KEY=lumo_dev_key_2026
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Database & Cache
DATABASE_URL=postgresql://lumo:lumo_secret@localhost:5432/lumo_db
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=lumo
POSTGRES_PASSWORD=lumo_secret
POSTGRES_DB=lumo_db

# AI Provider Configuration
# local_ollama (default zero-cost) or openai
LUMO_AI_PROVIDER=local_ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=

# Telegram Accessibility Gateway
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
LUMO_BOT_DEFAULT_LANG=en

# Privacy & Telemetry
# Strict zero-telemetry policy enforced during learner playback
LUMO_TELEMETRY_ENABLED=false
