{
  "openapi": "3.1.0",
  "info": {
    "title": "Lumo Accessibility Infrastructure API",
    "description": "\n    Open REST APIs for media accessibility, automated captioning, document remediation (PDF to HTML),\n    offline learning packages, and source-grounded educational Q&A for Digital Bridge Hackathon 2026.\n    ",
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Health",
        "description": "System health check and diagnostic status",
        "operationId": "get_health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/captions/generate": {
      "post": {
        "tags": [
          "Captions"
        ],
        "summary": "Generate Captions",
        "description": "Submit a video/audio media URL for automated caption generation",
        "operationId": "generate_captions_v1_captions_generate_post",
        "parameters": [
          {
            "name": "X-Lumo-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "X-Lumo-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptionGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptionJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/captions/{caption_id}": {
      "get": {
        "tags": [
          "Captions"
        ],
        "summary": "Get Caption Track",
        "description": "Retrieve generated WebVTT caption file content",
        "operationId": "get_caption_track_v1_captions__caption_id__get",
        "parameters": [
          {
            "name": "caption_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Caption Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/process": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Process Document",
        "description": "Upload a course document (PDF or text) to generate accessible, screen-reader ready HTML.",
        "operationId": "process_document_v1_documents_process_post",
        "parameters": [
          {
            "name": "X-Lumo-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "X-Lumo-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_document_v1_documents_process_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentProcessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}/html": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get Accessible Html",
        "description": "Retrieve rendered accessible HTML document",
        "operationId": "get_accessible_html_v1_documents__document_id__html_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/packages/generate": {
      "post": {
        "tags": [
          "Offline Packages"
        ],
        "summary": "Generate Offline Package",
        "description": "Generate an offline, low-bandwidth lesson package (< 10 MB) containing speech audio,\ndual captions, plain transcripts, and an accessible offline HTML player.",
        "operationId": "generate_offline_package_v1_packages_generate_post",
        "parameters": [
          {
            "name": "X-Lumo-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "X-Lumo-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/packages/{package_id}/download": {
      "get": {
        "tags": [
          "Offline Packages"
        ],
        "summary": "Download Package",
        "description": "Download compiled offline package zip file",
        "operationId": "download_package_v1_packages__package_id__download_get",
        "parameters": [
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Package Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/lessons/{lesson_id}/ask": {
      "post": {
        "tags": [
          "AI Educator"
        ],
        "summary": "Ask Lesson Question",
        "description": "Source-grounded Q&A tutor for a lesson.\nAll answers are strictly constrained to the course transcript and cite exact timestamps.",
        "operationId": "ask_lesson_question_v1_lessons__lesson_id__ask_post",
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lesson Id"
            }
          },
          {
            "name": "X-Lumo-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "X-Lumo-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskQuestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskQuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "transcript_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript Text"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskQuestionRequest"
      },
      "AskQuestionResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations",
            "default": []
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score",
            "default": 0.95
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "transcript_grounded"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AskQuestionResponse"
      },
      "Body_process_document_v1_documents_process_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "Course Document"
          },
          "lang": {
            "type": "string",
            "title": "Lang",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_process_document_v1_documents_process_post"
      },
      "CaptionGenerateRequest": {
        "properties": {
          "media_url": {
            "type": "string",
            "title": "Media Url"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "target_languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Languages",
            "default": [
              "en",
              "am"
            ]
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url"
          }
        },
        "type": "object",
        "required": [
          "media_url"
        ],
        "title": "CaptionGenerateRequest"
      },
      "CaptionJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "estimated_duration_seconds": {
            "type": "integer",
            "title": "Estimated Duration Seconds"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "estimated_duration_seconds",
          "created_at"
        ],
        "title": "CaptionJobResponse"
      },
      "Citation": {
        "properties": {
          "timestamp_start": {
            "type": "string",
            "title": "Timestamp Start"
          },
          "timestamp_end": {
            "type": "string",
            "title": "Timestamp End"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "type": "object",
        "required": [
          "timestamp_start",
          "timestamp_end",
          "excerpt"
        ],
        "title": "Citation"
      },
      "DocumentProcessResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "accessible_html_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accessible Html Url"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/FlaggedItem"
            },
            "type": "array",
            "title": "Flags",
            "default": []
          },
          "metrics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metrics",
            "default": {}
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "status",
          "created_at"
        ],
        "title": "DocumentProcessResponse"
      },
      "FlaggedItem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "FlaggedItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "storage": {
            "type": "string",
            "title": "Storage"
          },
          "ai_provider": {
            "type": "string",
            "title": "Ai Provider"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database",
          "storage",
          "ai_provider",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "PackageGenerateRequest": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "video_url": {
            "type": "string",
            "title": "Video Url"
          },
          "captions_en_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captions En Url"
          },
          "captions_am_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captions Am Url"
          }
        },
        "type": "object",
        "required": [
          "lesson_id",
          "title",
          "video_url"
        ],
        "title": "PackageGenerateRequest"
      },
      "PackageJobResponse": {
        "properties": {
          "package_id": {
            "type": "string",
            "title": "Package Id"
          },
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "package_id",
          "lesson_id",
          "status",
          "download_url",
          "size_bytes",
          "created_at"
        ],
        "title": "PackageJobResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}