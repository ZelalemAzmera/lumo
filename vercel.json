{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "services/api",
      "framework": "fastapi"
    },
    "telegram-bot": {
      "root": "apps/telegram-bot",
      "runtime": "python",
      "entrypoint": "bot/webhook.py",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "LUMO_API_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    }
  ]
}
